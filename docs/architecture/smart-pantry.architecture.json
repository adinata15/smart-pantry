  "cards": [
    {
      "dot": "cyan",
      "title": "Containers",
      "items": [
        "Docker Compose runs web, api, and postgres on one network",
        "The web container serves the static React client on :8080",
        "AWS stays later; these images remain the deploy unit"
      ]
    },
    {
      "dot": "emerald",
      "title": "API modules",
      "items": [
        "One Fastify plugin per context: identity, household, inventory, consumption, intake, catalog, recommendations",
        "Domain rules stay off the framework and off the Prisma client",
        "@smart-pantry/contracts keeps the /v1 wire format shared"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust",
      "items": [
        "Session cookie stores a hashed token; CORS is credentialed",
        "OPENAI_API_KEY lives only in the API container",
        "Receipt text is not sent to the model; the matcher answers when the model cannot"
      ]
    }
  ]
